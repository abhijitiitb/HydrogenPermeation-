############INITIALIZATION#####################

units		metal 
dimension	3
boundary    	p p p
atom_style	atomic

#variable        t equal 298
#variable	disp index 0.01

################ATOM DEFINITION################

read_data 	dump_initial2.lammps
#read_data 	NiH_without_initial_corner.lammps
#read_data 	NiH_without_final_corner.lammps

neighbor	2.8 bin

neigh_modify   every 1 delay 0 check yes
###############SETTINGS#######################

pair_style	eam/alloy
#pair_coeff      1 2 
pair_coeff	* * NiAlH_jea.eam.alloy Ni Al H

timestep	0.00001 # time in picosecond
#delete_atoms    overlap 0.1 all all
#########Outpt########################
#dump              1 all custom 1 NiH_Initial_24696.dump id type x y z
dump              1 all custom 1 NiH_Initial_24696.dump id type x y z
dump_modify       1 sort id

thermo		100
thermo_style    custom step temp press pxx pyy pzz ke pe etotal density
thermo_modify   norm no

##############energy minimization#######
#min_style       cg
#minimize        1e-25 2.3062e-24 10000 100000
#reset_timestep	0
#minimize	 2.3e-11 2.3e-11 10000 100000
minimize	 1e-10 1e-10 10000 100000
#fix       1 all nve
run 100
write_data   neb_initial.lammps
#write_data   neb_final.lammps




















